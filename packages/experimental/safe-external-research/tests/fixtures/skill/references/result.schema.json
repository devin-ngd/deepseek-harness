{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Safe external research result v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "summary",
    "sources",
    "findings",
    "risk_flags",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "ok",
        "partial",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 1600
    },
    "sources": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "url",
          "locator"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^s[1-9][0-9]*$",
            "maxLength": 8
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "locator": {
            "type": "string",
            "maxLength": 240
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement",
          "kind",
          "source_ids"
        ],
        "properties": {
          "statement": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1600
          },
          "kind": {
            "enum": [
              "fact",
              "inference"
            ]
          },
          "source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^s[1-9][0-9]*$",
              "maxLength": 8
            }
          }
        }
      }
    },
    "risk_flags": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "instruction_override",
          "private_data_request",
          "unauthorized_egress",
          "code_execution_request",
          "permission_change",
          "source_mismatch",
          "active_content",
          "other"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    }
  }
}
