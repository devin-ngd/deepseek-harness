{
  "name": "@deepseek-ai/dsh-experimental-harmony-mobile",
  "version": "0.0.0-rc2.37",
  "private": true,
  "type": "module",
  "description": "Default-disabled private Harmony mobile profile adapter with independent authenticated peer admission",
  "license": "MIT",
  "main": "lib/index.js",
  "types": "lib/types/desktop-plugin/src/index.d.ts",
  "exports": {
    "./product": {
      "types": "./lib/types/desktop-plugin/src/product.d.ts",
      "default": "./lib/product.js"
    },
    ".": {
      "types": "./lib/types/desktop-plugin/src/index.d.ts",
      "default": "./lib/index.js"
    },
    "./admission": {
      "types": "./lib/types/desktop-plugin/src/admission.d.ts",
      "default": "./lib/admission.js"
    },
    "./transport": {
      "types": "./lib/types/desktop-plugin/src/transport.d.ts",
      "default": "./lib/transport.js"
    },
    "./package.json": "./package.json",
    "./pairing": {
      "types": "./lib/types/desktop-plugin/src/pairing.d.ts",
      "default": "./lib/pairing.js"
    },
    "./test-session": {
      "types": "./lib/types/desktop-plugin/src/test-session.d.ts",
      "default": "./lib/test-session.js"
    },
    "./client": {
      "types": "./lib/client-types/desktop-plugin/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./device": {
      "types": "./lib/types/desktop-plugin/src/device-binding-command.d.ts",
      "default": "./lib/device.js"
    }
  },
  "files": [
    "lib",
    "workspace-shell",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "licenses",
    "build-info.json",
    "pairing.enabled.example.json",
    "test-session.enabled.example.json",
    "device.enabled.example.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-commands",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "dependencies": {
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-gfm": "^3.0.0",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-hmr": "0.2.2-rc.4",
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/schemastery": "~3.19.0",
    "@deepseek-ai/dsh": "0.2.2-rc.4",
    "@deepseek-ai/dsh-app-boot": "0.2.2-rc.4",
    "@deepseek-ai/dsh-plugin-detail": "0.2.2-rc.4",
    "@deepseek-ai/dsh-plugin-manager": "0.2.2-rc.4",
    "@deepseek-ai/dsh-credentials": "0.2.2-rc.4",
    "@deepseek-ai/dsh-authorization": "0.2.2-rc.4",
    "@deepseek-ai/dsh-scope": "0.2.2-rc.4",
    "@deepseek-ai/dsh-api-session-controller": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-query": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session": "0.2.2-rc.4",
    "@deepseek-ai/dsh-experimental-rich-inline": "0.2.2-rc.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.4",
    "@deepseek-ai/dsh-typert-registry": "0.2.2-rc.4",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.4",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.4",
    "@deepseek-ai/dsh-brand": "0.2.2-rc.4",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.4",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.4",
    "@deepseek-ai/dsh-api-gateway": "0.2.2-rc.4",
    "@deepseek-ai/dsh-api-workspace-controller": "0.2.2-rc.4",
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.4",
    "@deepseek-ai/dsh-workspace": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-persistence": "0.2.2-rc.4",
    "@deepseek-ai/dsh-commands": "0.2.2-rc.4",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.4",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.4",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.2-rc.4",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.4",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.4",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-commands": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-session": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-locale": "0.2.2-rc.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-plugin-manager": "0.2.2-rc.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.4",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.4",
    "react": "^18.2.0"
  }
}
